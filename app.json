{
  "expo": {
    "name": "Metric Sense",
    "slug": "metric-sense",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.papaacorn.metricsense",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "package": "com.papaacorn.metricsense",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "edgeToEdgeEnabled": true
    },
    "scheme": "metricsense",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    }
  }
}
